{
  "name": "@truckbeez/api",
  "version": "0.1.0",
  "private": true,
  "description": "TruckBeez API (Express + Socket.IO)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "npm run build -w @truckbeez/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "predev": "npm run build -w @truckbeez/shared",
    "dev": "tsx watch src/server.ts",
    "pretypecheck": "npm run build -w @truckbeez/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build -w @truckbeez/shared",
    "test": "vitest run",
    "pretest:routing-safety": "npm run build -w @truckbeez/shared",
    "test:routing-safety": "vitest run -t @routing-safety --reporter=default --reporter=json --outputFile.json=reports/routing-safety.json && node scripts/assert-tests-ran.mjs reports/routing-safety.json 50",
    "pretest:unit": "npm run build -w @truckbeez/shared",
    "test:unit": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "dependencies": {
    "@truckbeez/shared": "*",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.73.0"
  }
}
