# Copy to .env and fill in. Never commit .env.

PORT=4000

# HERE Routing v8 key. Stays on the server and is never sent to the app (BR-4).
# Leave empty in development to get a straight-line "(demo route)" instead.
# Required when NODE_ENV=production.
HERE_API_KEY=

# Comma-separated origins allowed to call the API from a browser. Leave empty to allow all in development.
CORS_ORIGINS=
