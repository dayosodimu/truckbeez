PORT=4000
# Get a key at https://platform.here.com
HERE_API_KEY=
# LOCAL DEVELOPMENT ONLY: with no HERE key, serve a straight-line demo route that ignores
# truck restrictions. Never set this in staging, preprod or production.
ALLOW_DEMO_ROUTE=true

# --- TruckBeez Fleet (B2B) ---
# Leave STRIPE_SECRET_KEY empty for demo billing (checkout activates instantly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Where Stripe Checkout sends owners back to
APP_URL=https://truckbeez.app
# Days to keep completed trips and breadcrumbs
FLEET_RETENTION_DAYS=90
