{
  "expo": {
    "name": "TruckBeez",
    "slug": "truckbeez",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.beesroute.truckbeez",
      "supportsTablet": true
    },
    "android": {
      "package": "com.beesroute.truckbeez"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TruckBeez uses your location while the app is open to tell when you're driving, so it can lock typing for your safety.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ]
  }
}
