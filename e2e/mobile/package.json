{
  "name": "@truckbeez/e2e-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "TruckBeez mobile E2E: Appium 2 + WebdriverIO, TypeScript, Page Objects (BR-13)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "drivers:android": "appium driver install --source=npm appium-uiautomator2-driver@4",
    "drivers:ios": "appium driver install --source=npm appium-xcuitest-driver@9",
    "e2e:android": "wdio run ./wdio.android.conf.ts",
    "e2e:android:smoke": "wdio run ./wdio.android.conf.ts --mochaOpts.grep @smoke",
    "e2e:ios": "wdio run ./wdio.ios.conf.ts",
    "e2e:ios:smoke": "wdio run ./wdio.ios.conf.ts --mochaOpts.grep @smoke",
    "report": "allure generate reports/allure-results --clean -o reports/allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/globals": "^9.4.0",
    "@wdio/junit-reporter": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "@wdio/types": "^9.4.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "webdriverio": "^9.4.0"
  }
}
