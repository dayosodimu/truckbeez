{
  "name": "truckbeez",
  "private": true,
  "description": "TruckBeez monorepo (ADR-0003): services/api, packages/shared, apps/mobile",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "npm run build -w @truckbeez/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "expo-font": "~14.0.12"
  }
}
