{
  "name": "truckbeez",
  "private": true,
  "description": "TruckBeez: Waze-style navigation for truck drivers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @truckbeez/api",
    "dev:mobile": "npm run start -w @truckbeez/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
