# Copy to deploy/env/staging.env on the staging host (or let CI write it from
# the GitHub `staging` environment secret ENV_FILE). Never commit the real file.
APP_ENV=staging
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgres://truckbeez:change-me@postgres:5432/truckbeez
REDIS_URL=redis://:change-me@redis:6379/0
STRIPE_MODE=test
EDGE_PORT=8080
# Error reporting (Sentry). Optional: empty = off. One DSN per environment, from the
# Sentry project's Client Keys page; store it only in this environment's ENV_FILE secret.
SENTRY_DSN=
