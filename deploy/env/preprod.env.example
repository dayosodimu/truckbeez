# Copy to deploy/env/preprod.env on the preprod host (or let CI write it from
# the GitHub `preprod` environment secret ENV_FILE). Never commit the real file.
# Every <placeholder> must be replaced: the API refuses to start with one (docs/secrets.md).
# Data loaded here must be anonymised — no real driver locations or PII.
APP_ENV=preprod
POSTGRES_PASSWORD=<postgres-password>
REDIS_PASSWORD=<redis-password>
DATABASE_URL=postgres://truckbeez:<postgres-password>@postgres:5432/truckbeez
REDIS_URL=redis://:<redis-password>@redis:6379/0
STRIPE_MODE=test
EDGE_PORT=8080
# Optional until the feature using them ships. Leave empty or set the real value.
HERE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
