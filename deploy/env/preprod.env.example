# Copy to deploy/env/preprod.env on the preprod host (or let CI write it from
# the GitHub `preprod` environment secret ENV_FILE). Never commit the real file.
# Data loaded here must be anonymised — no real driver locations or PII.
APP_ENV=preprod
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgres://truckbeez:change-me@postgres:5432/truckbeez
REDIS_URL=redis://:change-me@redis:6379/0
STRIPE_MODE=test
EDGE_PORT=8080
# Error reporting (Sentry). Optional: empty = off. One DSN per environment, from the
# Sentry project's Client Keys page; store it only in this environment's ENV_FILE secret.
SENTRY_DSN=
