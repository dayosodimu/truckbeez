# Copy to deploy/env/prod.env on the prod host (or let CI write it from the
# GitHub `production` environment secret ENV_FILE). Never commit the real file.
# Points at MANAGED Postgres (PostGIS) and Redis — not containers.
APP_ENV=prod
DATABASE_URL=postgres://truckbeez:<secret>@<managed-postgres-host>:5432/truckbeez?sslmode=require
REDIS_URL=rediss://:<secret>@<managed-redis-host>:6380/0
STRIPE_MODE=live
EDGE_PORT=8080
